# Copie para .env (nunca versione o .env) e troque TODOS os valores de exemplo.
# Gere segredos com: openssl rand -hex 32

# Diretório do backend (contexto de build). Padrão: ../doasync-backend/backend
#DOASYNC_BACKEND_DIR=../doasync-backend/backend

# Banco de dados
POSTGRES_DB=doasync
POSTGRES_USER=doasync
POSTGRES_PASSWORD=troque-esta-senha

# Backend (perfil prod)
DOASYNC_JWT_SEGREDO=troque-por-um-segredo-aleatorio-de-64-hex
ADMIN_EMAIL=admin@doasync.local
ADMIN_PASSWORD=troque-esta-senha-admin
SWAGGER_ENABLED=false
# Origens permitidas (padrão: http://localhost:WEB_PORT). Em produção: https://seu-dominio
#DOASYNC_CORS_ORIGINS=https://doasync.exemplo.org

# Portas no host
WEB_PORT=8090
API_PORT=8091
